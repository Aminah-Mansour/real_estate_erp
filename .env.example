# Copy to .env (scripts/dev_setup.sh generates one with random values). Never commit .env.
ERP_ENV=development
ERP_DEV_DB_PORT=5433
ERP_DEV_POSTGRES_PASSWORD=change-me
ERP_DEV_APP_DB_PASSWORD=change-me
ERP_DEV_AUTH_DB_PASSWORD=change-me
ERP_OWNER_DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5433/erp
ERP_APP_DATABASE_URL=postgresql://erp_app_login:change-me@127.0.0.1:5433/erp
ERP_AUTH_DATABASE_URL=postgresql://erp_auth_login:change-me@127.0.0.1:5433/erp
ERP_SECRET_KEY=change-me-to-at-least-32-random-characters
